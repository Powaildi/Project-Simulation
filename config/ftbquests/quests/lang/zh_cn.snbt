	quest.0199D2B8C04D51A1.quest_desc: [
		"每个轴有两个方向，用扳手旋转；"
		"红石充能后停止起重机移动，并将应力传到起重机取物器。"
	]
	quest.0199D2B8C04D51A1.quest_subtitle: "向停止移动的机器传递应力"
	quest.01E55B6567AE27DD.quest_desc: [
		"给管道套壳或者用扳手右键变成玻璃管形式，可以阻止管道自动连接。"
		"给管道染色可以阻止不同色管道自动连接。"
		"{@pagebreak}"
		"管道扳手可以调整管道的连接。"
		"用管道扳手右键管道，也能阻止管道自动连接，shift右键管道解除。"
		"{@pagebreak}"
		"如果你没有管道扳手，就丢弃你手里的扳手，这样就能变成管道扳手。"
	]
	quest.01E55B6567AE27DD.quest_subtitle: "使用管道扳手改变连接的法则"
	quest.02426635645BB447.quest_subtitle: "塞进样板供应器"
	quest.02426635645BB447.title: "样板"
	quest.0247E25E1EF5BE93.quest_desc: ["推荐放进me箱子中，然后放入染料或者染色球"]
	quest.0247E25E1EF5BE93.quest_subtitle: "给线缆上色"
	quest.0247E25E1EF5BE93.title: "染色器"
	quest.025D3545CFDA92BC.quest_subtitle: "另一个选择"
	quest.02AE894307BE87B7.quest_subtitle: "一虚一实"
	quest.03B68793A3855E06.quest_desc: [
		"右键组装物理结构，这个结构被转动时，根据阻力和转速提供应力。"
		"Shift右键以调整阻力大小。"
		"最多提供2,000,000su应力；如果有结构中有黑名单方块，则最多提供400,000su。"
		"物品提示仅供参考，请以实际应力输出为准!"
	]
	quest.03B68793A3855E06.quest_subtitle: "恭迎新神降临"
	quest.03E1FF1EBAAC726E.quest_subtitle: "风弹驱动"
	quest.03E1FF1EBAAC726E.title: "运输器和流体传输器"
	quest.040DF246743F2681.quest_desc: [
		"分子装配室会主动向6个方向传输样板和合成材料；"
		"扳手右键分子装配室就可以让它固定向某一面传这些。"
		"{@pagebreak}"
		"只要样板标记的产物回到网络，就算合成完成，不管中间是怎么处理的，甚至可以是手搓！"
		"然而，当你打开了 锁定合成-直到主产物被返回 模式，产物就得回到这个样板供应器，才能让它继续发送材料！"
		"{@pagebreak}"
		"分子装配室可以单走，这种情况下可以直接放一个样板进去，它也能进行合成。"
	]
	quest.040DF246743F2681.quest_subtitle: "下单和自动合成"
	quest.05080367636F746B.quest_subtitle: "超级燃烧之一"
	quest.0530F866F0C5EDD2.quest_subtitle: "现在开始搭建你的第一艘飞艇"
	quest.058A306939F2A867.quest_desc: [""]
	quest.058A306939F2A867.quest_subtitle: "动态结构"
	quest.061579E55CFCD5AF.quest_desc: ["女仆饰品，如果你觉得不保险可以用。"]
	quest.061579E55CFCD5AF.quest_subtitle: "绿色的云莓？"
	quest.070C1AF80BD8C2E3.quest_desc: ["注意：工作盆盖板和工作盆铸造盖执行的不是同一种配方！"]
	quest.070C1AF80BD8C2E3.quest_subtitle: "放在工作盆上面"
	quest.077ECF29212AFD4C.quest_subtitle: "连接多条传送带，在顶部设定物流规则"
	quest.082BC4F3A23DF1A3.quest_subtitle: "浮力"
	quest.08C6A7A19C537F32.quest_subtitle: "是的，它可以合成"
	quest.0983EC4C5B82647D.quest_desc: [
		"[修改配置]无限流体池所需格数：10000->512;"
		"允许软管滑轮直接填充无限流体池。"
		"{@pagebreak}"
		"软管滑轮不需要一直通入应力。"
		"让软管头停留在空中，输入流体即可填充流体池到软管头所在格；"
		"填满后让软管头沉底，即可无限抽出。"
		"支持无限抽出的流体：水、熔岩、巧克力、蜂蜜、冷冻液"
	]
	quest.0983EC4C5B82647D.quest_subtitle: "无限抽取！"
	quest.09FC03E3ABD3DEE7.quest_desc: [
		"开放容器"
		"如果工作盆东南西北斜下角有传送带、置物台、分液池等开放容器，它就会向那里开口，自动将处理完的物品和流体输出到那里。"
		"{@pagebreak}"
		"从另一个角度来说，如果你发现工作盆向它开口，它就是开放容器！"
		"如果它向你不想要的那一面开口了，就用扳手右键你想开口那一面。"
	]
	quest.09FC03E3ABD3DEE7.quest_subtitle: "含自动输出功能"
	quest.0A5E2E86219B753F.quest_desc: [
		"包层线缆降低渲染压力"
		"智能线缆显示频道占用"
	]
	quest.0A5E2E86219B753F.title: "包层线缆和智能线缆"
	quest.0AD7B62AF0C3772F.quest_subtitle: "吸取掉落物"
	quest.0B1C1CC339570182.quest_desc: ["[ \"你至少在制造出\", { \"text\": \"ME扩展接口\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"0C7FB0E13AD5BE48\" } }, \"以后才能制造！\" ]"]
	quest.0B1C1CC339570182.quest_subtitle: "提供和吸收物质"
	quest.0B1CC582366222D7.quest_desc: ["通入燃料后燃烧，相当于加热的烈焰人燃烧室。"]
	quest.0B1CC582366222D7.quest_subtitle: "高炉cos烈焰人燃烧室"
	quest.0B1CC582366222D7.title: "燃烧器"
	quest.0D22AE7BA883E752.quest_desc: ["开放容器"]
	quest.0D22AE7BA883E752.quest_subtitle: "不妨把它当做置物台"
	quest.0EFE5894220E5B85.quest_desc: [
		"比如1x1抽屉，一旦使用配置工具锁定，即使物品全部被取出，不匹配的物品也不会进入。"
		"{@pagebreak}"
		"最合适的应该是精妙存储的背包，它能非常优雅地解决循环装配中间产物堆积的问题。"
		"——给前面两三格放半成品，后面填满原料（每格只要放一个），然后找到栏位记忆功能，记忆全部栏位。这样就能保证半成品总是能先进行下一步，尽快变成成品，以免半成品填满容器，卡停产线。"
		"{@pagebreak}"
		"在极端情况下，你也可以使用工程师工具箱，它也有栏位记忆功能。"
	]
	quest.0EFE5894220E5B85.quest_subtitle: "使用具有栏位记忆的存储方块"
	quest.0FBB5F3D1C5E3A9C.quest_desc: ["爆炒无线合成终端[森罗物语真实瞬间]"]
	quest.0FBB5F3D1C5E3A9C.quest_subtitle: "以防你把无线终端炒了"
	quest.0FCB2695748A8CD7.quest_desc: ["听到这个不用费心思去找有背包的怪，因为不存在的。"]
	quest.0FCB2695748A8CD7.quest_subtitle: "它为什么在自己放"
	quest.0FFB58E57B41DC77.quest_desc: ["按下F3+H，你可以看到物品的命名空间和id，命名空间是Create的是打板的冲压机，Vintage Improvements的是模具的冲压机。"]
	quest.0FFB58E57B41DC77.quest_subtitle: "以前叫辊压机"
	quest.103619ECEE085C73.quest_subtitle: "那么，我们开始吧？"
