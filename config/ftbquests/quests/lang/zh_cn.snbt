	]
	quest.1B15DAA931F356C8.quest_subtitle: "补偿"
	quest.1B26B34F4E8FB480.quest_desc: [
		"风弹可以用于增殖烈焰粉，"
		"烈焰粉可以制成烈焰棒，"
		"烈焰棒能做成旋风棒，"
		"旋风棒能做成风弹。"
	]
