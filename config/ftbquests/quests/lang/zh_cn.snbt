	quest.403E0FC8B877BB82.quest_subtitle: "制作冲压机的模版"
	quest.40D3B6819181FFD5.quest_desc: [
		"恭喜你完成第一章！"
		"如果有想法，还可以继续游玩，做出钢锭就算毕业。"
		"如果发现有什么需要改进的地方，随时在群里和我说。"
	]
	quest.40D3B6819181FFD5.title: "第一章完全完成"
	quest.4279C7A6565AED0C.quest_subtitle: "丝绸之触"
	quest.4279C7A6565AED0C.title: "精准采集"
	quest.43C16273D16F3372.quest_subtitle: "一次出一组，可过滤和调整数量"
	quest.445AE1D2E559C3B4.quest_desc: [
		"动力泵每4rpm就提供10mB/t流速；"
