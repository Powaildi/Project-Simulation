	quest.12E6DEF90A35C9BD.quest_desc: [
		"开放容器"
		"往上面丢要处理的物品，处理完后右键取出。"
	]
	quest.13998C57E753F87F.quest_desc: [
		"用扳手调整每个格子的合成方向，合成材料最终要汇集到一起。"
		"从背面调整可以让一些格子连接。"
		"合成的出口可以放一个容器。"
		"{@pagebreak}"
		"使用合成槽盖板表示这里是空气；"
		"使用红石充能强制开始合成。"
	]
	quest.13998C57E753F87F.quest_subtitle: "对我弱小的应力来源造成了极大的打击"
