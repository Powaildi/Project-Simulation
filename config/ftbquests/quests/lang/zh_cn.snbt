	quest.39C2795AFBF3BF50.quest_subtitle: "加快随机刻"
	quest.3A2BA0179D3427F6.quest_desc: ["有一些需要你有管理员权限！"]
	quest.3A2BA0179D3427F6.quest_subtitle: "与刚才的相反"
	quest.3A7A79D470A26577.quest_subtitle: "附着在采矿机动态结构上"
	quest.3BDBB52B158BEBFA.title: "羊毛自增殖"
	quest.3BE27FEE59ECE692.quest_desc: ["更多的压印模板不会在这里展示，而是将它们的产物放在任务中。"]
	quest.3D4147E44C0A90F8.quest_desc: ["从ME控制器拉出来32个频道"]
	quest.3D4147E44C0A90F8.quest_subtitle: "传递32个频道"
	quest.3D4147E44C0A90F8.title: "致密线缆"
	quest.3D4B9A068D12708C.quest_desc: ["[修改配置]长度 40格 -> 200格"]
	quest.3D66BE6FFD11EB64.quest_desc: [
		"开放容器"
		"右键两个传动杆，在它们之间创建传送带，最长20格。"
		"空手右键传送带，把上面的东西拿下来。"
		"传送带的末端有开放容器时，物品会输出到这个容器。"
		"{@pagebreak}"
		"经过Apertyotis的改进，你可以手持扳手直接调整传送带的转速！"
		"依靠传送带传动的其他传动元件不会受到影响，各走各的。"
		"更多的修改，详见Wheels Upon Chairs的配置文件。"
	]
	quest.3D8FEA109DE83181.title: "抽油机"
	quest.3E3DE48243CBFD65.title: "破坏核心和成型核心"
	quest.3EFEB4F6AA3160A3.quest_subtitle: "复制配置"
	quest.3F268AF2847961FD.quest_subtitle: "试试用它来制作安山合金"
	quest.3F91B9A9B32FC4DF.quest_subtitle: "用于放置物品和流体等组件"
	quest.3FF5C9B379E26866.quest_desc: [
		"将方块以物品形式扔出去，或者放在世界中。然后看着它，Jade（就是屏幕顶部的那个东西）会显示它的物理性质，比如质量(kpg)。"
		"佩戴&e工程师护目镜&r以后，将鼠标悬停在物品上就能看到。"
