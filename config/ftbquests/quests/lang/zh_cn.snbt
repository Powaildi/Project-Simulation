	quest.1EF93DED50739580.quest_subtitle: "编辑元件"
	quest.1FC02254EFFE1CE0.quest_desc: [""]
	quest.1FC02254EFFE1CE0.quest_subtitle: "来自附属mod的传动元件"
	quest.1FC02254EFFE1CE0.title: "特殊传动手段"
	quest.2111149AE352A053.quest_subtitle: "挖掉它，寻找陨石中心的外星科技"
	quest.2142E4744C27EF45.quest_subtitle: "移动空间"
	quest.24482FF7F5A5C497.quest_desc: ["你知道JEI可以翻页吗？"]
	quest.24482FF7F5A5C497.quest_subtitle: "最安全最方便的一集"
	quest.24482FF7F5A5C497.title: "鼓风机触媒"
	quest.24B67411E9633D6D.title: "粉碎羊毛出更多"
	quest.2578C69D83581EDA.quest_desc: [
		"两个粉碎轮中间会生成粉碎轮控制器，对其中的生物造成伤害（无视盔甲与附魔）。"
		"配方结束以后，控制器会将产物投入前下方（横放）或者正下方（竖放，思索中的）的开放容器，如果没有开放容器，就在世界上生成掉落物。"
	]
	quest.2578C69D83581EDA.quest_subtitle: "注重生产安全"
	quest.259C4083619FD9B8.quest_desc: [
		"长按侧面调整模式，通常使用旋转锁定，"
		"搭配控制铁轨可以做直线农场。"
		"{@pagebreak}"
		"使用扳手shift右键装配后的矿车能直接带走矿车上的东西。"
	]
	quest.259C4083619FD9B8.quest_subtitle: "一把抓住，顷刻炼化"
	quest.25F1115E9916C61C.quest_desc: ["需要更好的工具"]
	quest.26323D539543CF46.quest_subtitle: "让别人用"
	quest.270B696D6B36D811.quest_desc: [
		"你可能在别的包见过那个灰色的水龙头。"
		"它是Supplemantaries的，然而这个包没有，建议不要为此安装这个mod！"
		"水龙头能注液和填充工作盆，但是不能填充流体到封闭的容器。"
		"或许一些中期的科技能帮到你！"
		"{@pagebreak}"
		"水龙头不能对传送带上的物品注液，那是注液器和智能水龙头才能干的事情。"
	]
	quest.29B0B67CB6D44B5D.quest_desc: ["后续内容正在制作"]
	quest.29B0B67CB6D44B5D.quest_subtitle: "通用机械的大门向你打开"
	quest.2ADE68F0135119C2.quest_desc: [
